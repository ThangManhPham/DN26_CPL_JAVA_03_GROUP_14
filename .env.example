# Local development only. Copy to .env and replace the sample password.
DB_NAME=ourspace
DB_USERNAME=ourspace
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5432
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Optional in dev. If omitted, the dev profile generates a temporary JWT key on startup.
# Use a fixed Base64 key from at least 32 random bytes only when needed for local testing.
JWT_SECRET=
JWT_ISSUER=ourspace
JWT_TTL_SECONDS=3600
