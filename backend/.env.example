# Mẫu tham khảo; Spring Boot/Maven không tự nạp .env.
# Không commit .env hoặc secret thật.
SPRING_PROFILES_ACTIVE=dev

# Dev mặc định: H2 in-memory + Flyway. Không cần đặt signing key.
# Đặt datasource để dùng PostgreSQL và giữ dữ liệu qua restart:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ourspace
# SPRING_DATASOURCE_USERNAME=ourspace
# SPRING_DATASOURCE_PASSWORD=replace-with-local-password

# BẮT BUỘC khi không chạy profile dev: Base64 của >=32 random bytes.
# JWT_SECRET=generate-a-random-base64-key-see-README
JWT_ISSUER=ourspace
JWT_TTL_SECONDS=3600
# SERVER_PORT=8080
