<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FCE8EC">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="♥ OurSpace"
        android:textColor="#C74E70"
        android:textSize="16sp"
        android:textStyle="bold" />
    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Ảnh mới nhất của hai bạn"
        android:scaleType="centerCrop" />
    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mở OurSpace để xem ảnh"
        android:textColor="#29262B"
        android:textSize="12sp" />
</LinearLayout>
